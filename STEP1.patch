+
+int _occurrences(String source, String pattern) {
+  if (pattern.isEmpty) return 0;
+  var count = 0;
+  var offset = 0;
+  while (true) {
+    final index = source.indexOf(pattern, offset);
+    if (index < 0) return count;
+    count++;
+    offset = index + pattern.length;
+  }
+}
