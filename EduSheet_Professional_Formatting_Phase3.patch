+        fields.add(match);
+      } else if (element.properties['hideMissingFields'] != true) {
+        fields.add(
+          PaperHeaderField(
+            id: '',
+            label: label,
+            isPlaceholder: true,
+          ),
+        );
+      }
+    }
+    fields.addAll(
+      paper.headerFields.where(
+        (field) => !requestedKeys.contains(field.label.trim().toLowerCase()),
+      ),
+    );
+    return List<PaperHeaderField>.unmodifiable(fields);
+  }
