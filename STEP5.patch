+            style: advanced.answerSpace.style,
+            lines: advanced.answerSpace.lines,
+            questionOverride: true,
+          ),
+          fontSize,
+          indentLeft: indentLeft + 240,
+        ),
+      );
+    }
+
+    return buffer.toString();
+  }
