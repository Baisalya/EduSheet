+                  const SizedBox(height: 12),
+                  QuestionMathTextField(
+                    controller: _title,
+                    decoration: const InputDecoration(
+                      labelText: 'Heading (optional)',
+                      hintText: 'Read the passage and answer the questions',
+                    ),
+                  ),
+                  const SizedBox(height: 12),
+                  QuestionMathTextField(
+                    controller: _text,
